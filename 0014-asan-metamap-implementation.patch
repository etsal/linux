diff --git a/tools/testing/selftests/bpf/libarena/src/asan.bpf.c b/tools/testing/selftests/bpf/libarena/src/asan.bpf.c
index 7d39ee7b68bd..5f921f369e33 100644
--- a/tools/testing/selftests/bpf/libarena/src/asan.bpf.c
+++ b/tools/testing/selftests/bpf/libarena/src/asan.bpf.c
@@ -11,6 +11,27 @@
 #pragma clang attribute push(__attribute__((no_sanitize("address"))), \
 			     apply_to = function)
 
+/*
+ * Shadow meta map. We do not want to naively allocate the maximum map
+ * size (4GiB) at map startup. We instead want to allocate new shadow
+ * map pages on demand. 
+ *
+ * We use a bitmap to track which pages in the shadow map have been allocated.
+ * Each bit corresponds to a >= 4KiB shadow page, and so to a >= 32KiB allocated
+ * region. That means to track the shadow map of a 4GiB region we need
+ *
+ * (4GiB / (32KiB / bit))
+ * = (4GiB) / (256KiB / byte))
+ * = (4096 MiB) / (256KiB / byte)) 
+ * = 16KiB = 256 64-bit words. 
+ *
+ * We allocate this statically.
+ */
+
+#define asan_meta_LEN (256)
+
+u64 __arena asan_meta[asan_meta_LEN];
+
 #define SHADOW_ALL_ZEROES ((u64)-1)
 
 /*
@@ -18,6 +39,7 @@
  */
 volatile u64 asan_violated = 0;
 
+
 /*
  * Shadow map occupancy map.
  */
@@ -32,6 +54,88 @@ volatile bool asan_inited = false;
 volatile bool asan_report_once = false;
 volatile bool asan_emit_stack = false;
 
+/*
+ * Metamap access routines.
+ */
+
+static inline
+u64 asan_meta_first_unalloc(u64 pgoff, size_t nr_pages)
+{
+	return arena_find_word(asan_meta, pgoff, nr_pages, false);
+}
+
+static inline
+u64 asan_meta_first_alloc(u64 pgoff, size_t nr_pages)
+{
+	return arena_find_word(asan_meta, pgoff, nr_pages, true);
+}
+
+/*
+ * Allocate any missing shadow map pages for a range
+ * of nr_pages arena pages, starting from pgoff.
+ */
+__weak
+int asan_populate_shadowmap_pages(u64 pgoff, size_t pgleft)
+{
+	u64 pgfirst;
+	void __arena *mem;
+	u64 nr_pages;
+	u64 target;
+
+	while (pgleft && can_loop) {
+
+		/* Find the first unallocated pages within the range. */
+		pgfirst = asan_meta_first_unalloc(pgoff, pgleft);
+		pgleft -= (pgfirst - pgoff);
+		if (!pgleft)
+			return 0;
+
+		/* 
+		 * Find how big the range of unallocated
+		 * pages we can allocate at once.
+		 */
+		nr_pages = asan_meta_first_alloc(pgfirst, pgleft) - pgfirst;
+		pgleft -= nr_pages;
+
+		/* Find the offset */
+		target = __asan_shadow_memory_dynamic_address + (pgfirst * __PAGE_SIZE);
+
+		/* 
+		 * The allocated map pages are zeroed out, meaning all memory is marked as valid
+		 * even if it's not allocated already. This is expected: Since the actual memory
+		 * pages are not allocated, accesses to it will trigger page faults and will be
+		 * reported through BPF streams. Any pages allocated through bpf_arena_alloc_pages
+		 * should be poisoned by the allocator right after the call succeeds.
+		 */
+		mem = bpf_arena_alloc_pages(&arena, (void __arena *)target, nr_pages, NUMA_NO_NODE, 0);
+		if (mem)
+			return -ENOMEM;
+
+		/* Mark the allocated pages in the metamap. */
+		bitmap_set_range(asan_meta, pgfirst, nr_pages);
+
+		pgoff = pgfirst + nr_pages;
+	}
+
+	return 0;
+}
+
+static __always_inline
+int asan_populate_shadowmap(u64 addr, size_t size)
+{
+	u64 pgfirst, pglast;
+	u64 lastaddr;
+
+	/* Get the arena pages to be touched during poisoning. */ 
+
+	pgfirst = addr / __PAGE_SIZE;
+	lastaddr = addr + size - 1;
+	pglast = (lastaddr + __PAGE_SIZE - 1) / __PAGE_SIZE;
+
+	return asan_populate_shadowmap_pages(pgfirst, pglast - pgfirst + 1);
+}
+
+
 /*
  * BPF does not currently support the memset/memcpy/memcmp intrinsics.
  */
