+	 * a page fault, which still gives us the same information as ASAN.
+	 * Since we are touching an unallocated page, the ASAN check itself
+	 * will succeed.
+	 */
+
 	switch (size) {
 	case 1:
 		is_poisoned = memory_is_poisoned_1(addr);
@@ -298,6 +407,7 @@ __hidden __noasan int asan_poison(void __arena *addr, s8 val, size_t size)
 {
 	s8a *shadow;
 	size_t len;
+	int ret;
 
 	/*
 	 * Poisoning from a non-granule address makes no sense: We can only allocate
@@ -331,6 +441,11 @@ __hidden __noasan int asan_poison(void __arena *addr, s8 val, size_t size)
 	if (unlikely(size & ASAN_GRANULE_MASK))
 		return -EINVAL;
 
+	/* Populate any missing pages in the arena metamap. */
+	ret = asan_populate_shadowmap((u64)addr, size);
+	if (unlikely(ret))
+		return ret;
+
 	shadow = mem_to_shadow(addr);
 	len = size >> ASAN_SHADOW_SHIFT;
 
@@ -398,7 +513,7 @@ __hidden __noasan int asan_init(struct asan_init_args *args)
 {
 	u64 globals_pages = args->arena_globals_pages;
 	u64 all_pages = args->arena_all_pages;
-	u64 shadowmap, shadow_pgoff;
+	u64 shadow_pgoff;
 	u64 shadow_pages;
 
 	if (asan_inited)
@@ -433,24 +548,6 @@ __hidden __noasan int asan_init(struct asan_init_args *args)
 	shadow_pgoff = all_pages - shadow_pages - globals_pages;
 	__asan_shadow_memory_dynamic_address = shadow_pgoff * __PAGE_SIZE;
 
-	/* 
