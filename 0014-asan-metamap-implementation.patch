diff --git a/tools/testing/selftests/bpf/libarena/include/common.h b/tools/testing/selftests/bpf/libarena/include/common.h
index 12fab01d60f9..0a6ddbc8795a 100644
--- a/tools/testing/selftests/bpf/libarena/include/common.h
+++ b/tools/testing/selftests/bpf/libarena/include/common.h
@@ -96,8 +96,139 @@ int arena_fls(__u64 word)
 	return num;
 }
 
+static inline
+int arena_ffs(__u64 word)
+{
+	unsigned int num = 0;
+
+	if ((word & 0xffffffff) == 0) {
+		num += 32;
+		word >>= 32;
+	}
+
+	if ((word & 0xffff) == 0) {
+		num += 16;
+		word >>= 16;
+	}
+
+	if ((word & 0xff) == 0) {
+		num += 8;
+		word >>= 8;
+	}
+
+	if ((word & 0xf) == 0) {
+		num += 4;
+		word >>= 4;
+	}
+
+	if ((word & 0x3) == 0) {
+		num += 2;
+		word >>= 2;
+	}
+
+	if ((word & 0x1) == 0) {
+		num += 1;
+		word >>= 1;
+	}
+
+	return num;
+}
+
+__weak
+u64 arena_find_word(u64 __arena __arg_arena *bitmap, u64 start, u64 count, bool find_set)
+{
+	u64 word, bit, pos;
+	u64 val;
+	u64 skip_val = find_set ? 0 : (u64)(-1);
+
+	if (!count)
+		return start;
+
+	word = start / 64;
+	bit = start % 64;
+	pos = start;
+
+	/* Check first partial word if not word-aligned. */
+	if (bit) {
+		val = find_set ? bitmap[word] : ~bitmap[word];
+		/* Mask off bits before our starting position. */
+		val &= ~((1ULL << bit) - 1);
+
+		if (val) {
+			u64 found = word * 64 + arena_ffs(val);
+			if (found < start + count)
+				return found;
+			return start + count;
+		}
+
+		word++;
+		pos = word * 64;
+		if (pos >= start + count)
+			return start + count;
+	}
+
+	/* Skip full words that don't contain the bit we're looking for. */
+	for (; pos + 64 <= start + count && can_loop; word++, pos += 64) {
+		if (bitmap[word] != skip_val)
+			break;
+	}
+
+	if (pos >= start + count)
+		return start + count;
+
+	/* Check the word we stopped at. */
+	val = find_set ? bitmap[word] : ~bitmap[word];
+	if (val) {
+		u64 found = word * 64 + arena_ffs(val);
+		if (found < start + count)
+			return found;
+	}
+
+	return start + count;
+}
+
+/*
+ * Set a range of bits in a bitmap.
+ *
+ * @bitmap: pointer to the u64 array
+ * @start: starting bit position
+ * @count: number of bits to set
+ */
+static inline
+void bitmap_set_range(u64 __arena *bitmap, u64 start, u64 count)
+{
+	u64 word, bit, bits_in_word;
+
+	if (!count)
+		return;
+
+	word = start / 64;
+	bit = start % 64;
+
+	/* Handle partial first word. */
+	if (bit) {
+		bits_in_word = 64 - bit;
+		if (count < bits_in_word)
+			bits_in_word = count;
+
+		/* Set bits from 'bit' for 'bits_in_word' bits. */
+		bitmap[word] |= (((1ULL << bits_in_word) - 1) << bit);
+
+		word++;
+		count -= bits_in_word;
+	}
+
+	/* Handle full words. */
+	for (; count >= 64 && can_loop; word++, count -= 64)
+		bitmap[word] = (u64)(-1);
+
+	/* Handle partial last word. */
+	if (count)
+		bitmap[word] |= ((1ULL << count) - 1);
+}
+
 /*
- * Userspace API, required for setting up the arena 
+ * Userspace API, required for setting up the arena
  * address space before starting the allocator.
